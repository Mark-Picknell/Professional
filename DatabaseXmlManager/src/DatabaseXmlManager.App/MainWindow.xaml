<Window x:Class="DatabaseXmlManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Database XML Manager" Height="640" Width="1000">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#B71C1C" Padding="10" Visibility="{Binding ProductionBannerVisibility}"><TextBlock Text="PRODUCTION" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16"><TextBlock Text="Environment:" VerticalAlignment="Center" Margin="0,0,8,0" /><ComboBox Width="140" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" /></StackPanel>
    <Grid Margin="16"><TextBlock Text="DatabaseXmlManager foundation is ready." FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock Text="{Binding Status}" /></StatusBar>
  </DockPanel>
</Window>
